# Diagrama de contenedores (modelo C4) con los mecanismos de retención.
# Etiquetas cortas y de varias líneas a propósito: así el diagrama sale compacto y se lee en la página.
direction: right
vars: {d2-config: {layout-engine: elk}}
classes: {
  propio: {style: {fill: "#1168bd"; stroke: "#0b4884"; font-color: "#ffffff"; border-radius: 6; font-size: 26}}
  nuevo: {style: {fill: "#2e7d32"; stroke: "#1b5e20"; font-color: "#ffffff"; border-radius: 6; font-size: 26}}
  externo: {style: {fill: "#8a8a8a"; stroke: "#6b6b6b"; font-color: "#ffffff"; border-radius: 6; font-size: 26}}
  persona: {style: {fill: "#08427b"; font-color: "#ffffff"; border-radius: 20; font-size: 26}}
  zona: {style: {fill: "#fffaf0"; stroke: "#c98a00"; stroke-dash: 4; border-radius: 10; font-color: "#7a5300"; font-size: 28; bold: true}}
}

titular: "Titular de\nla tarjeta" {class: persona}
equipo: "Equipo de\nTarjetazo" {class: persona}

app: "App Tarjetazo\nAndroid · Kotlin" {
  style: {fill: "#f4f8fc"; stroke: "#1168bd"; stroke-dash: 4; border-radius: 10; font-size: 28; bold: true}
  ui: "Lista de gastos\nracha · resumen\ndel mes" {class: nuevo}
  prefs: "Preferencias\nqué avisos y\ndía de cierre" {class: nuevo}
  avisos: "Servicio Avisos\n4 canales\nabre la pantalla\ndel aviso" {class: nuevo}
  sdk: "SDKs de\nFirebase" {class: propio}

  avisos -> ui: "toque" {style.font-size: 22}
  ui -> sdk: "última\napertura" {style.font-size: 22}
  prefs -> sdk: "preferencias" {style.font-size: 22}
  avisos -> sdk: "token" {style.font-size: 22}
}

gcp: "Google Cloud" {
  class: zona
  scheduler: "Cloud Scheduler\ntodos los días\na las 10" {class: propio}
  diaria: "Job avisos\nCloud Run\n1 aviso por usuario" {class: nuevo}
  campania: "Job campaña\nCloud Run\ninactivos 14 días" {class: nuevo}
}

firebase: "Firebase" {
  class: zona
  fs: "Cloud Firestore\nusuarios · avisos\ndispositivos · gastos" {shape: cylinder; class: propio}
  fcm: "Cloud Messaging\npor token y\npor tema novedades" {class: propio}
  consola: "Consola\nde Firebase" {class: externo}
}

titular -> app.ui: "usa" {style.font-size: 22}
equipo -> firebase.consola: "campañas" {style.font-size: 22}
equipo -> gcp.campania: "reactivación" {style.font-size: 22}
app.sdk -> firebase.fs: "gRPC" {style.font-size: 22}
gcp.scheduler -> gcp.diaria: "HTTPS" {style.font-size: 22}
gcp.diaria -> firebase.fs: "lee y guarda" {style.font-size: 22}
gcp.campania -> firebase.fs: "busca inactivos" {style.font-size: 22}
gcp.diaria -> firebase.fcm: "FCM v1" {style: {stroke: "#2e7d32"; stroke-width: 3; font-size: 22}}
gcp.campania -> firebase.fcm: "por token" {style.font-size: 22}
firebase.consola -> firebase.fcm: "publica en\nel tema" {style.font-size: 22}
firebase.fcm -> app.avisos: "push" {style: {stroke: "#2e7d32"; stroke-width: 3; font-size: 22}}
